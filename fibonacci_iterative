def fibonacci_iterative(n):
    if n == 0:
        return "Please enter the positive number: "
    elif n == 1:
        return [0]
    elif n == 2:
        return [0,1]
    else:
        fib_series = [0, 1]
        for i in range(2, n):
            next_num = fib_series[i-1] + fib_series[i-2]
            fib_series.append(next_num)
        return fib_series
        
        
result = fibonacci_iterative(15)
print(result)
