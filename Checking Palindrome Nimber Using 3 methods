# Using numerical method
def Check_Palindrome_Number(num):
    original_num = num
    reversed_num = 0
    while num>0:
        last_dig = num%10
        reversed_num = reversed_num*10 + last_dig
        num = num // 10
        
    return reversed_num == original_num
    
print(Check_Palindrome_Number(121))

# Using string method
def Check_Palindrome_Number1(num):
    str_num = str(num)
    return str_num == str_num[::-1]
    
print(Check_Palindrome_Number1(234))

#Using Stack
def Check_Palindrome_Number2(num):
    str_num = str(num)
    stack = []
    for char in str_num:
        stack.append(char)
    
    reversed_num = ""
    while stack:
        reversed_num += stack.pop()
    
    return  str_num == reversed_num   
    
print(Check_Palindrome_Number2(2377)) 
